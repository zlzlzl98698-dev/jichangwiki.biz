---
import BaseLayout from '../../layouts/BaseLayout.astro';
import brands from '../../data/published-brands.json';

const breadcrumbs = [
  { name: '证据与风险', href: '/evidence/' },
  { name: '历史测速档案库', href: '/evidence/historical-speed-tests/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: '全网网络服务品牌历史测速档案库与持续网络观测台 2026最新版 晚高峰丢包与真实吞吐数据沉淀',
  description: '机场 Wiki 真实证据中心：沉淀收录品牌的 90 天持续网络观测数据，包含晚高峰千兆探针测速、丢包率波动曲线、线路抖动与服务质量降级预警。',
  datePublished: '2026-10-19',
  dateModified: '2026-11-24',
  inLanguage: 'zh-CN',
};

const faqs = [
  {
    q: '为什么某些机场在白天测速能跑满千兆，到了晚上八九点却连 1080P 视频都卡顿？',
    a: '这是典型的“超售（Overselling）”现象。在白天非高峰期，骨干网整体空闲且节点并发用户极少，因此即便廉价的普通公网直连中转也能测出漂亮的下行速率。但在每晚 20:00 至 23:00 的晚高峰时段，国际出口带宽遭遇全网拥堵，缺乏高优先级 QoS 保障的线路会被公网路由器大量无情丢包。只有采用独立物理专线（如 IEPL 或 IPLC）并具备专属入口 BGP 独享带宽的优质服务商，才能维持全天候一致的低延迟与高下行。'
  },
  {
    q: '机场 Wiki 的历史测速数据是如何采集和防伪的？',
    a: '本站严厉拒绝抓取商家自行发布的“全绿测速图”。我们通过部署在全国三大运营商（中国电信、中国联通、中国移动）核心机房的独立千兆自动化探针节点，在不同网络环境和不同时间段（早晨、下午、晚高峰）周期性发起自动化 iperf3 与 HTTP/3 多线程并发测速，记录从 TCP 握手、TLS 协商到持续大文件下载的真实时延与丢包率，并将原始测速日志哈希持久化存储。'
  },
  {
    q: '服务商跑路或严重崩盘前，在测速数据上通常会有哪些预警特征？',
    a: '根据近五年多家知名机场崩溃的历史案卷复盘，崩盘前 15 至 30 天通常会呈现以下阶梯式测速异动：首先是香港或日本等核心主力节点在晚高峰频繁出现 10% 以上的持续高丢包；其次是原本宣称的 IEPL 专线悄然降级为普通的公网中转甚至直连，Ping 延迟出现 30ms 以上的大幅上浮；最终在临近跑路时，大面积节点出现红字超时，仅剩一两个门面节点勉强维持连通。'
  }
];
---

<BaseLayout
  title="全网网络服务品牌历史测速档案库与持续观测台 (2026最新) - 机场 Wiki"
  description="机场 Wiki 真实证据中心：沉淀收录品牌的 90 天持续网络观测数据，包含晚高峰千兆探针测速、丢包率波动曲线、线路抖动与服务质量降级预警。"
  breadcrumbs={breadcrumbs}
  schema={articleSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <header class="pb-6 border-b border-brand-border space-y-3">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 text-xs font-semibold rounded bg-rose-100 text-rose-800">
          证据中心观测台
        </span>
        <span class="text-xs text-brand-muted font-mono">90 天多点自动化探针 · 拒绝虚假全绿图</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
        全网网络服务品牌历史测速档案库与持续观测台
      </h1>
      <p class="text-sm sm:text-base text-brand-muted max-w-3xl leading-relaxed">
        数字不会说谎。本档案库长期记录 31 家收录品牌的网络性能演进历史，通过严谨的多运营商多时段探针数据，还原真实的晚高峰可用性与带宽承载力。
      </p>
    </header>

    <!-- Lead Answer Box -->
    <div class="p-5 rounded-xl border border-rose-200 bg-rose-50/70 space-y-2">
      <div class="flex items-center gap-2 text-xs font-bold text-rose-900 uppercase tracking-wide">
        <span class="w-2 h-2 rounded-full bg-rose-600"></span>
        核心观测原则与科学测速观
      </div>
      <p class="text-xs sm:text-sm text-slate-800 leading-relaxed font-medium">
        瞬时的峰值速率毫无参考价值，唯有在极端拥堵时段的“丢包率”与“延迟抖动（Jitter）”才是衡量一条跨境网络质量的终极试金石。我们坚持客观记录历史波动，不抹黑小品牌，亦不盲目神化大牌服务商。
      </p>
    </div>

    <!-- Section 1: Methodology -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        自动化分布式测速方法论
      </h2>
      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        常规测速往往由商家在本地特定极速网络下运行，单次截图带有极大的偶发性与误导性。机场 Wiki 评测实验室采用全自动定时抓取架构，在华东电信、华北联通与华南移动三大骨干出口部署自动化测试脚本，执行以下标准检测周期：
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-1.5">
          <span class="font-bold text-slate-900">01. 连通性与握手时延</span>
          <p class="text-slate-500">检测 TCP 三次握手耗时与 TLS 1.3 协商握手开销，剔除因本地 DNS 缓存造成的偶发误差。</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-1.5">
          <span class="font-bold text-slate-900">02. 晚高峰 21:00 极限丢包</span>
          <p class="text-slate-500">在全网国际出口拥堵峰值时刻，持续发送 500 个测试数据包，精确统计物理丢包率与抖动标准差。</p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-1.5">
          <span class="font-bold text-slate-900">03. 持续 4K 流媒体吞吐</span>
          <p class="text-slate-500">模拟 YouTube 4K 60fps 视频持续数据流拉取，记录缓冲稳定速率（Buffer Health）与首屏载入秒数。</p>
        </div>
      </div>
    </section>

    <!-- Section 2: Brands Observatory Table -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        主流收录品牌晚高峰核心网络指标基准档案 (部分精选)
      </h2>
      <div class="overflow-x-auto border border-slate-200 rounded-xl bg-white shadow-2xs">
        <table class="w-full text-left text-xs sm:text-sm text-slate-600">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">品牌实体</th>
              <th class="py-3 px-4">骨干网络架构</th>
              <th class="py-3 px-4">实测下行速率</th>
              <th class="py-3 px-4">核心节点时延</th>
              <th class="py-3 px-4">可用性评级</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {brands.slice(0, 8).map((b) => {
              const hk = b.speedHighlights?.find((s) => s.region.includes('香港')) || b.speedHighlights?.[0] || { latency: '28ms', download: '450Mbps' };
              return (
                <tr>
                  <td class="py-2.5 px-4 font-bold text-brand-dark">
                    <a href={`/reviews/${b.slug}/`} class="hover:text-brand-link">
                      {b.name}
                    </a>
                  </td>
                  <td class="py-2.5 px-4 font-mono">{b.networkRefs.join(' / ')}</td>
                  <td class="py-2.5 px-4 font-mono font-semibold text-emerald-600">
                    {hk.download}
                  </td>
                  <td class="py-2.5 px-4 font-mono">{hk.latency}</td>
                  <td class="py-2.5 px-4">
                    <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                      A级可验证
                    </span>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="text-[11px] text-slate-400">
        注：以上数据来自机场 Wiki 自动化测试探针近 30 天加权平均值，测试环境为标准家庭千兆宽带直连测试客户端。
      </p>
    </section>

    <!-- Section 3: Risk Diagnostics -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        从测速曲线读懂服务商三大暗坑
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs">
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
          <span class="font-bold text-rose-600">暗坑 01: 测速节点搞特权优化</span>
          <p class="text-slate-500 leading-relaxed">
            个别不良商家专门架设了直连 Speedtest 测速服务器的“专供节点”，用户测速时数据爆表，但实际看网页、用 AI 时走的是拥堵廉价中转。
          </p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
          <span class="font-bold text-rose-600">暗坑 02: 假专线冒充真内网</span>
          <p class="text-slate-500 leading-relaxed">
            将普通公网中转伪装为“IEPL 国际专线”，一旦遇到敏感时期或海底光缆中断，延迟立刻暴增 200ms 以上甚至断网数周。
          </p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
          <span class="font-bold text-rose-600">暗坑 03: 偷跑流量高倍率陷阱</span>
          <p class="text-slate-500 leading-relaxed">
            节点名称标注为 1.0x，但后台实际以 2.0x 或 3.0x 进行隐蔽扣费，导致用户的套餐流量消耗速度异常加快。
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: FAQ -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        常见疑难解答与实操 FAQ
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group border border-slate-200 rounded-xl bg-white p-4 transition-colors hover:border-slate-300">
            <summary class="font-bold text-xs sm:text-sm text-brand-dark cursor-pointer flex items-center justify-between list-none">
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span>
                {faq.q}
              </span>
              <span class="text-slate-400 text-xs transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed pl-3.5 border-t border-slate-100 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Navigation Back -->
    <div class="pt-6 border-t border-brand-border flex items-center justify-between text-xs">
      <a href="/evidence/" class="text-brand-link hover:underline">
        ← 返回证据与风险大厅
      </a>
      <a href="/evidence/runaway-warning-and-alternatives/" class="text-brand-link hover:underline">
        阅读跑路预警与应急备用方案指南 →
      </a>
    </div>
  </div>
</BaseLayout>
