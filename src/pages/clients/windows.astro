---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '客户端', href: '/clients/' },
  { name: 'Windows 电脑代理选型与实操', href: '/clients/windows/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'Windows 电脑代理软件选型指南与深度实操 2026 最新版 Clash Verge Rev 与 v2rayN 正版下载与 TUN 模式深度配置',
  description: '告别旧版 CFW 停止维护风险。深度解析 Windows 11 与 Windows 10 平台主流代理软件 Clash Verge Rev 基于 Mihomo 内核、v2rayN、FlClash 的选型逻辑，实装 Wintun 全局虚拟网卡，彻底解决 UWP 回环隔离与关机后浏览器无法上网等系统级痛点。',
  datePublished: '2026-10-19',
  dateModified: '2026-11-24',
  inLanguage: 'zh-CN',
};

const faqs = [
  {
    q: '为什么旧版 Clash for Windows 必须尽快替换，继续使用有什么安全隐患？',
    a: '旧版 Clash for Windows（CFW）早已于二零二三年底由原作者正式宣布归档停止更新。继续使用不仅无法支持近年来新增的各类高性能协议与优质分流规则集，更关键的是其内置的 Electron 运行时与底层旧版 Clash 核心存在未经修补的远程代码执行和解析漏洞。此外，旧版 CFW 不支持现代 Wintun 驱动的高级特性，在 Windows 11 的高版本更新中极易引发内核级系统蓝屏与网络栈死锁。'
  },
  {
    q: '为什么平时在浏览器打开网页很快，但在 Windows 终端运行 Git 或 Python 时却提示连接失败？',
    a: '常规的代理软件默认仅开启系统代理（System Proxy）。这种模式本质上只是向 Windows 注册表中写入了 HTTP 与 HTTPS 环境变量，只有遵循该注册表项的通用浏览器软件能够识别。而 Windows 命令行工具（如 CMD、PowerShell、Git Bash）、开发环境运行库（如 Python requests、Node.js fetch、Docker）以及各类大型联机游戏均属于非代理敏感型应用，它们会直接绕过注册表代理向物理网卡发起原始 TCP 或 UDP 套接字连接。必须开启 TUN 虚拟网卡模式，或者在终端中手动执行环境变量导入命令，才能让底层网络数据包被接管。'
  },
  {
    q: '退出代理软件之后，为什么电脑所有浏览器突然全部断网，甚至连百度也打不开？',
    a: '这是 Windows 系统代理最经典的残留锁死故障。当代理软件在运行状态下被强制结束进程、意外崩溃或电脑异常断电关机时，软件未来得及将 Windows 注册表中的 ProxyEnable 开关由一还原为零。此时操作系统依然强制要求所有网络请求转发给本机的指定本地监听端口（如 127.0.0.1:7890）。但由于代理软件已经关闭，该端口没有任何后台服务在监听，导致所有应用在建立连接时被系统直接拒接。解决办法是重新打开软件并正常退出，或者在系统的代理设置中手动将代理服务器开关关闭。'
  },
  {
    q: '什么是 Windows UWP 回环隔离，为什么开启代理后微软商店和某些自带应用无法联网？',
    a: '微件系统与 Windows 现代应用（UWP 应用，例如 Microsoft Store、自带邮件、Xbox 伴侣）受到操作系统严密的 AppContainer 沙盒安全机制限制。系统默认禁止任何 UWP 沙盒进程向本地回环地址（即 127.0.0.1 代理监听端口）发送任何网络流量，防止恶意软件在本地进行权限越界嗅探。要让这类应用正常使用代理，必须通过 Windows 自带的 CheckNetIsolation 工具或利用客户端内置的 Loopback 豁免工具解除指定应用的本地网络回环限制。'
  },
  {
    q: '在 Clash Verge Rev 中开启 TUN 模式时提示服务安装失败或虚拟网卡创建失败，应如何处理？',
    a: 'TUN 模式需要在系统底层注册虚拟网络适配器驱动程序（Wintun.dll）。出现报错通常是由于用户当前是以受限权限运行软件，或者第三方杀毒防护软件（如各类管家或卫士）强行拦截了系统服务写入操作。正确的处理步骤是：先退出杀毒软件的弹窗拦截，右键点击软件图标选择以管理员身份运行，在软件内置的内核设置面板中重新点击安装服务模式（Service Mode），安装成功后系统托盘图标旁边会显示一个绿色的授权盾牌标志，随后再次开启 TUN 模式即可顺畅运行。'
  },
  {
    q: 'Windows 平台下 Clash Verge Rev 与 v2rayN 究竟该怎么选择？',
    a: '如果你追求现代化美观的图形界面、需要强大的智能规则分流（自动区分国内直连、海外直连、海外流媒体与学术数据库）、需要一键接管所有应用流量的现代化 TUN 模式，并且你的订阅源是由成熟机场提供的 Clash 托管链接，Clash Verge Rev 是毫无争议的首选。如果你是专业网络维护人员，需要高频测试成百上千个原始协议节点（如原始 VMess、VLESS、Trojan、Shadowsocks 单节点链接），需要精细查看底层 Xray 或 sing-box 原始日志，或者使用的是低配老旧电脑，那么轻量级且节点调试极其直观的 v2rayN 会更加高效。'
  },
  {
    q: '为什么有时节点测速都显示有延迟绿色数字，但访问任何海外网站都提示 DNS 解析超时？',
    a: '节点测速通常只是向代理节点入口发送简单的 TCP 握手数据包，仅证明你与代理服务器之间的物理通信通道是畅通的。而实际访问网页需要完整的 DNS 域名解析、协议解密与海外落地机房二次转发。如果海外落地服务器当地的 DNS 发生解析上游中断，或者本地配置文件中的 DNS 模块配置了错误的无污染上游服务器，就会出现节点虽然连通但实际网页无法解析的假死现象。可以在客户端设置中将 DNS 模式切换为 Fake-IP 并确认海外 DNS 填入了权威上游地址（如 1.1.1.1 或 8.8.8.8）。'
  },
  {
    q: '使用 Clash Verge Rev 时，如何避免订阅配置文件被服务商的远程更新强制覆盖我自定义的规则？',
    a: '不要直接在下载好的订阅原始 YAML 文件中手动写入自己的规则，因为一旦执行右键更新订阅，远程服务器下发的最新文件会直接覆盖本地改动。Clash Verge Rev 提供了强大的订阅合并功能（Merge）与脚本扩展机制（Script）。用户应当在软件的配置扩展面板中新建一个独立的规则合并模板，将自己的自定义规则（例如指定某些域名走直连或走特定代理组）写在模板中。这样每次订阅自动更新时，软件会自动将你的个性化规则无缝注入到最新配置文件顶部。'
  }
];
---

<BaseLayout
  title="Windows 电脑代理软件选型指南与深度实操 (2026最新) - Clash Verge Rev 与 v2rayN 正版指引"
  description="告别旧版 CFW 停止维护风险。深度解析 Windows 11 与 Windows 10 平台主流代理软件 Clash Verge Rev（基于 Mihomo 内核）、v2rayN、FlClash 的选型逻辑，实装 Wintun 全局虚拟网卡，彻底解决 UWP 回环隔离与关机后浏览器无法上网等系统级痛点。"
  breadcrumbs={breadcrumbs}
  schema={articleSchema}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">
    <!-- Header -->
    <header class="pb-8 border-b border-brand-border space-y-4">
      <div class="flex flex-wrap items-center gap-2">
        <span class="px-3 py-1 text-xs font-semibold rounded bg-blue-100 text-blue-800">
          Windows 专题深度指南
        </span>
        <span class="px-3 py-1 text-xs font-medium rounded bg-emerald-100 text-emerald-800">
          基于 Mihomo 现代内核
        </span>
        <span class="text-xs text-brand-muted">更新时间 2026 年 11 月 24 日</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
        Windows 电脑代理软件选型指南与深度实操：Clash Verge Rev、v2rayN 与 TUN 模式全方位评测
      </h1>

      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-4xl">
        在 Windows 桌面生态中，随着旧版 Clash for Windows（CFW）彻底停更并暴露出诸多兼容性与安全性缺陷，基于现代 Mihomo 内核的 <strong>Clash Verge Rev</strong> 与支持多内核引擎的 <strong>v2rayN</strong> 已经全面接管主流桌面工作台。本文从系统网络协议栈底层出发，深度解析两款主流软件的技术选型逻辑、Wintun 虚拟网卡配置细节、UWP 回环隔离机制救治方案，以及解决注册表残留导致的严重网络假死现象。
      </p>

      <div class="p-4 rounded-lg bg-amber-50 border border-amber-200 text-xs text-amber-900 flex items-start gap-3">
        <span class="text-base">⚠️</span>
        <div class="leading-relaxed">
          <strong>安全警示：</strong>由于代理类开源软件受关注度极高，搜索引擎与第三方下载站中充斥着大量夹带特洛伊木马、恶意数字证书注入脚本以及后门抓包模块的仿冒破解版。请务必严格通过官方开源代码仓库的 Releases 页面获取原始安装包，并核对官方发布的哈希签名。
        </div>
      </div>
    </header>

    <!-- Table of Contents Quick Nav -->
    <nav class="p-5 rounded-xl border border-slate-200 bg-slate-50 text-xs sm:text-sm space-y-3">
      <div class="font-bold text-brand-dark text-sm uppercase tracking-wider">本专题深度目录导航</div>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 text-brand-link">
        <a href="#selection-matrix" class="hover:underline">1. Windows 主流代理软件横向对比矩阵</a>
        <a href="#clash-verge-rev-deepdive" class="hover:underline">2. Clash Verge Rev 架构解析与深度配置</a>
        <a href="#tun-mode-wintun" class="hover:underline">3. Wintun 全局虚拟网卡与网络层截获</a>
        <a href="#uwp-loopback-fix" class="hover:underline">4. UWP 现代应用回环隔离与微软商店修复</a>
        <a href="#troubleshooting-windows" class="hover:underline">5. Windows 平台六大致命故障与注册表修复</a>
        <a href="#topic-clusters" class="hover:underline">6. Windows 客户端三级深度衍生选题矩阵</a>
        <a href="#faq-section" class="hover:underline">7. 高频技术疑问与操作解答</a>
      </div>
    </nav>

    <!-- Section 1: Selection Matrix -->
    <section id="selection-matrix" class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded"></span>
        Windows 主流代理客户端横向对比与技术决策树
      </h2>

      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        面对 Windows 平台纷繁复杂的网络加速工具，许多用户盲目跟风下载，却因底层网络适配不良出现卡顿、漏流量甚至系统崩溃。目前市场上活跃的四大客户端在底层技术架构、资源消耗与应用场景上存在本质区别：
      </p>

      <div class="overflow-x-auto border border-slate-200 rounded-xl shadow-2xs">
        <table class="w-full text-xs text-left text-slate-600">
          <thead class="bg-slate-100 text-brand-dark font-semibold border-b border-slate-200">
            <tr>
              <th class="p-3">软件名称</th>
              <th class="p-3">GUI 开发框架</th>
              <th class="p-3">默认核心引擎</th>
              <th class="p-3">内存常驻占用</th>
              <th class="p-3">TUN 虚拟网卡支持</th>
              <th class="p-3">适用人群定位</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-brand-dark">Clash Verge Rev</td>
              <td class="p-3">Tauri + Rust</td>
              <td class="p-3">Mihomo (原 Clash.Meta)</td>
              <td class="p-3 text-emerald-700 font-semibold">约 30MB 至 60MB</td>
              <td class="p-3 text-emerald-700">原生支持 Wintun 高性能驱动</td>
              <td class="p-3">广大日常用户、外企远程办公、学术研究、多媒体娱乐</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-brand-dark">v2rayN</td>
              <td class="p-3">.NET 8 / WPF 原生</td>
              <td class="p-3">Xray-core / sing-box</td>
              <td class="p-3 text-emerald-700 font-semibold">约 40MB 至 80MB</td>
              <td class="p-3 text-blue-700">支持 sing-box tun / tun2socks</td>
              <td class="p-3">网络工程师、多节点批量调试、自建 VPS 极客玩家</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-brand-dark">FlClash</td>
              <td class="p-3">Flutter 跨平台</td>
              <td class="p-3">Mihomo 内核</td>
              <td class="p-3 text-amber-700">约 90MB 至 150MB</td>
              <td class="p-3 text-emerald-700">支持原生 TUN 转发</td>
              <td class="p-3">追求全平台统一界面视觉交互的新潮用户</td>
            </tr>
            <tr class="hover:bg-slate-50">
              <td class="p-3 font-bold text-brand-dark text-slate-400">Clash for Windows (旧版)</td>
              <td class="p-3 text-slate-400">Electron 沉重架构</td>
              <td class="p-3 text-slate-400">开源版 Clash 停更老核</td>
              <td class="p-3 text-rose-700 font-semibold">高达 200MB 至 450MB</td>
              <td class="p-3 text-rose-700">依赖老旧 TAP 驱动（易蓝屏）</td>
              <td class="p-3 text-rose-700 font-semibold">已淘汰，存在安全漏洞，严禁继续使用</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="bg-blue-50/60 p-4 rounded-xl border border-blue-100 text-xs space-y-2">
        <div class="font-bold text-blue-900 text-sm">💡 核心选型决策原则</div>
        <p class="text-blue-800 leading-relaxed">
          对于绝大多数日常追求稳定、省心的 Windows 用户，直接选择 <strong>Clash Verge Rev</strong> 是兼顾性能、现代化审美与极低内存占用的最佳解法。如果你经常需要手动配置单条协议链接、测试复杂的自建 VPS 伪装参数，推荐使用 <strong>v2rayN</strong> 作为专业工程级备选。
        </p>
      </div>
    </section>

    <!-- Section 2: Clash Verge Rev Deep Dive -->
    <section id="clash-verge-rev-deepdive" class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded"></span>
        Clash Verge Rev 架构解析与深度实操指引
      </h2>

      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        Clash Verge Rev 之所以能在短时间内彻底取代旧版 CFW 成为社区标杆，核心在于其彻底摒弃了臃肿且容易遭受内存泄漏困扰的 Electron 框架，采用了基于 Rust 语言构建的 Tauri 轻量级跨平台架构，并全面深度整合了目前维护最活跃、功能最强大的 Mihomo 开源内核。
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-3">
          <div class="font-bold text-brand-dark text-sm flex items-center gap-2">
            <span class="text-blue-600">⚡</span>
            <span>Tauri 架构带来的性能飞跃</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            传统 Electron 应用实质上是在后台打包运行了一个完整的 Chromium 浏览器内核与 Node.js 运行时，启动即占用数百兆运行内存。而 Clash Verge Rev 采用操作系统自带的 WebView2 渲染组件配合 Rust 后台服务，常驻待机内存仅需几十兆，极大地降低了轻薄本和办公电脑的电池与系统开销。
          </p>
        </div>

        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-3">
          <div class="font-bold text-brand-dark text-sm flex items-center gap-2">
            <span class="text-emerald-600">🛡️</span>
            <span>Mihomo 内核的高级协议兼容</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            支持完整的 VLESS（XTLS Reality 握手模拟）、Hysteria 2 基于 UDP 拥塞控制的高速协议、TUIC 现代网络传输，以及基于 geosite 与 geoip 的高性能内存规则集匹配。即使面对极端恶劣的网络审查环境，也能依托底层新协议维持极高的通信质量。
          </p>
        </div>
      </div>

      <div class="bg-white p-6 rounded-xl border border-slate-200 space-y-4">
        <h3 class="text-base font-bold text-brand-dark">五步标准安全配置流程</h3>
        <ol class="space-y-3 text-xs sm:text-sm text-slate-600">
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">1</span>
            <div>
              <strong>获取正版程序：</strong>访问官方 GitHub 仓库（clash-verge-rev/clash-verge-rev），在 Releases 区域根据你的处理器架构下载 64 位安装程序（一般为 <code class="bg-slate-100 px-1 py-0.5 rounded text-slate-800">Clash.Verge_x.x.x_x64-setup.exe</code>）。
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">2</span>
            <div>
              <strong>导入订阅配置文件：</strong>启动软件后，在左侧导航栏点击“订阅 (Profiles)”，将服务商提供的 Clash 订阅链接粘贴到顶部的 URL 输入框中，点击右侧的“导入 (Import)”。导入成功后点击该卡片将其激活。
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">3</span>
            <div>
              <strong>选择最优节点策略：</strong>点击“代理 (Proxies)”面板，进入“节点选择 (PROXY)”策略组。初次使用建议选择“自动选择 (Auto)”以获得系统自动判定的最低延迟节点；或者手动指定经过 SLA 认证的高质量香港或日本专线节点。
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">4</span>
            <div>
              <strong>开启系统代理开关：</strong>在左侧“设置 (Settings)”中，将“系统代理 (System Proxy)”拨动至开启状态。此时打开 Edge 或 Chrome 浏览器即可正常浏览。
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-6 h-6 rounded-full bg-blue-100 text-blue-700 font-bold flex items-center justify-center shrink-0">5</span>
            <div>
              <strong>安装系统服务授权（关键）：</strong>在设置中找到“服务模式 (Service Mode)”，点击右侧的“安装”按钮，在 Windows UAC 提权弹窗中点击“允许”。服务安装成功后即可无缝启用 TUN 虚拟网卡功能。
            </div>
          </li>
        </ol>
      </div>
    </section>

    <!-- Section 3: TUN Mode & Wintun -->
    <section id="tun-mode-wintun" class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded"></span>
        Wintun 全局虚拟网卡与系统网络层截获机制
      </h2>

      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        许多 Windows 用户经常遇到一个令人困惑的技术现象：浏览器访问网页一切正常，但在 PowerShell 中运行 <code class="bg-slate-100 px-1 py-0.5 rounded text-slate-800">git clone</code>、在终端安装 Python 第三方库、或者启动外服战网与 Steam 游戏时，网络依然提示连接超时或直接暴露真实 IP。要彻底理解这一现象，必须认清应用层代理与网络层虚拟网卡的本质差异。
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-3">
          <div class="text-sm font-bold text-brand-dark flex items-center gap-2">
            <span class="text-amber-600">🌐</span>
            <span>传统系统代理（System Proxy）的局限</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            系统代理工作在第七层应用层。它的实现机制仅仅是在 Windows 注册表中设置了一个环境变量参数，告知遵循此规则的应用程序（主要是浏览器）将 HTTP/HTTPS 流量转发到 127.0.0.1:7890。然而，终端工具、开发环境库、各类远程连接协议（SSH/RDP）以及游戏客户端并不读取该注册表项，直接通过底层物理网卡发送原始 IP 数据包，因此传统代理对其完全失效。
          </p>
        </div>

        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-3">
          <div class="text-sm font-bold text-brand-dark flex items-center gap-2">
            <span class="text-blue-600">🛡️</span>
            <span>现代 Wintun 虚拟网卡（TUN 模式）的威力</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            TUN 模式工作在第三层网络层。借助高性能的 Wintun 驱动程序，代理软件在 Windows 网络适配器列表中虚拟出一块完全合法的软件网卡，并将操作系统的默认网关路由重定向至该虚拟网卡。此时，整台电脑中产生的所有 IP 数据包（包括 TCP、UDP、ICMP Ping 等）都会在进入物理硬件前被内核拦截并智能分流，实现真正的全系统无缝接管。
          </p>
        </div>
      </div>

      <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 space-y-3 text-xs sm:text-sm">
        <div class="font-bold text-brand-dark">TUN 模式开启三大黄金准则：</div>
        <ul class="list-disc list-inside space-y-1.5 text-slate-600">
          <li><strong>必须优先安装 Service Mode：</strong>如果未安装系统底层服务，TUN 模式只能依靠普通权限运行，极易在系统休眠唤醒后失去网络截获能力导致电脑彻底断网。</li>
          <li><strong>推荐开启 Fake-IP 域名解析：</strong>在 Mihomo 内核设置中将 DNS 模式配置为 Fake-IP（增强模式），可以让客户端在发出请求的一毫秒内拿到虚拟 IP 并直接建立底层代理握手，大幅减少远端域名解析带来的往返延迟。</li>
          <li><strong>严格配置局域网直连绕过：</strong>确保私有 IP 段（如 192.168.0.0/16、10.0.0.0/8、127.0.0.1）在 TUN 路由表中处于直连名单，防止局域网打印机、NAS 共享存储以及本地虚拟机出现通信阻断。</li>
        </ul>
      </div>
    </section>

    <!-- Section 4: UWP Loopback Fix -->
    <section id="uwp-loopback-fix" class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded"></span>
        UWP 现代应用回环隔离机制与微软商店断网救治
      </h2>

      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        自 Windows 8 引入并在 Windows 10 与 11 中全面强化的 UWP（通用 Windows 平台）应用架构，具有极为严苛的沙盒安全边界。为了防止恶意第三方软件在后台截获本地敏感通信，微软在操作系统内核层实施了网络隔离策略（AppContainer Network Isolation）。这种机制直接切断了 UWP 应用与本地回环地址（127.0.0.1）之间的通信可能。
      </p>

      <div class="p-5 rounded-xl border border-rose-200 bg-rose-50/50 space-y-3">
        <div class="font-bold text-rose-900 text-sm">典型故障现象</div>
        <p class="text-xs text-rose-800 leading-relaxed">
          当你开启了系统代理后，浏览器能够顺畅访问任何海外网站，但只要打开微软官方应用商店（Microsoft Store）、Windows 自带的邮件与日历、OneNote 或者是部分 Xbox 登录组件，就会立即弹出错误代码（如 0x80072EFD 或 0x80131500），提示“检查你的连接，未能连上服务器”。
        </p>
      </div>

      <div class="bg-white p-6 rounded-xl border border-slate-200 space-y-4">
        <h3 class="text-base font-bold text-brand-dark">三步彻底解决 UWP 隔离限制</h3>
        <div class="space-y-4 text-xs sm:text-sm text-slate-600">
          <div>
            <strong class="text-brand-dark block mb-1">方法一：使用 Clash Verge Rev 内置的 Loopback 豁免工具（推荐）</strong>
            <p class="leading-relaxed">
              在 Clash Verge Rev 的左侧“设置”面板中，找到“Windows 设置”区域下的“UWP 工具 (UWP Loopback)”。点击打开后，系统会扫描出本机安装的所有 UWP 应用。点击顶部的“豁免全部 (Exempt All)”按钮，然后点击“保存更改 (Save Changes)”。操作完成后立即生效，无需重启计算机。
            </p>
          </div>

          <div>
            <strong class="text-brand-dark block mb-1">方法二：利用 Windows 原生命令行工具批量授权</strong>
            <p class="leading-relaxed">
              如果你使用的是其他没有集成界面的客户端，可以右键点击“开始菜单”，选择“终端管理员 (PowerShell)”，然后粘贴执行以下官方网络隔离命令：
            </p>
            <pre class="bg-slate-900 text-slate-100 p-3 rounded font-mono text-xs overflow-x-auto mt-2">FOR /F "tokens=11 delims=\" %i IN ('REG QUERY "HKCU\Software\Classes\Local Settings\Software\Microsoft\Windows\CurrentVersion\AppContainer\Mappings"') DO CheckNetIsolation.exe LoopbackExempt -a -p=%i</pre>
            <p class="text-xs text-slate-500 mt-1">此命令将遍历系统注册表中的所有 AppContainer 应用标识，并调用底层的 CheckNetIsolation 实用工具为每个应用一键解除本地回环隔离限制。</p>
          </div>

          <div>
            <strong class="text-brand-dark block mb-1">方法三：直接切换至 TUN 虚拟网卡模式</strong>
            <p class="leading-relaxed">
              在 TUN 模式下，系统流量在第三层物理适配器层面即被虚拟网卡接管，不再经过本机的 127.0.0.1 端口转发，从而在根本上避开了 UWP 应用针对本地回环地址的安全拦截规则。
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 5: Windows Troubleshooting -->
    <section id="troubleshooting-windows" class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-bold text-brand-dark flex items-center gap-2">
        <span class="w-2 h-6 bg-blue-600 rounded"></span>
        Windows 平台六大致命故障与注册表深度修复
      </h2>

      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        根据机场 Wiki 数据中心对数万起 Windows 客户端工单的综合统计，百分之九十以上的网络异常并非由于机场线路故障，而是由操作系统底层参数异常、软件退出未还原注册表或系统安全软件拦截引发。以下提供标准化诊断与自救手册：
      </p>

      <div class="space-y-4">
        <!-- Issue 1 -->
        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-2">
          <div class="font-bold text-brand-dark text-sm flex items-center justify-between">
            <span>🔴 故障一：关机或关闭软件后，全电脑所有网页全部打不开</span>
            <span class="text-xs px-2 py-0.5 rounded bg-rose-100 text-rose-800 font-semibold">最高频故障</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>核心原因：</strong>软件在异常退出或强制关机时，未能将 Windows 注册表中的代理开关重置为 0，系统依然把请求发送给已关闭的 7890 端口。<br />
            <strong>一键解决：</strong>按键盘 <kbd class="bg-slate-100 px-1 py-0.5 rounded border border-slate-300">Win + I</kbd> 打开系统设置，进入“网络和 Internet” ➔ “代理”，在“手动设置代理”一栏中，将“使用代理服务器”的开关彻底拨动至“关闭”状态；或者重新打开代理软件，等待几秒后在托盘图标右键选择正常“退出”。
          </p>
        </div>

        <!-- Issue 2 -->
        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-2">
          <div class="font-bold text-brand-dark text-sm">
            <span>🔴 故障二：7890 或指定本地端口被其他后台程序占用，客户端启动报错</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>核心原因：</strong>部分开发环境工具、残留的旧代理进程或特殊杀毒软件占用了默认的 7890 监听端口，导致内核启动绑定失败。<br />
            <strong>解决步骤：</strong>打开 PowerShell 执行 <code class="bg-slate-100 px-1 py-0.5 rounded">netstat -ano | findstr :7890</code> 查看占用该端口的进程 PID，若为无用进程可在任务管理器中结束；或者在 Clash Verge Rev 的设置中将“混合端口 (Mixed Port)”手动修改为其他未被占用的端口（例如 7895 或 10808）。
          </p>
        </div>

        <!-- Issue 3 -->
        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-2">
          <div class="font-bold text-brand-dark text-sm">
            <span>🔴 故障三：系统时间与国际标准时间存在偏差，导致 TLS 握手彻底失效</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>核心原因：</strong>现代网络加密协议（如 TLS 1.3、XTLS Reality、VMess）对时间戳有着极高精度的安全校验。如果 Windows 主板电池老化或时钟不同步导致系统时间偏差超过 90 秒，服务器会判定握手包为重放攻击而直接丢弃。<br />
            <strong>解决步骤：</strong>进入 Windows 设置 ➔ “时间和语言” ➔ “日期和时间”，点击“立即同步”按钮，确保“自动设置时间”与“自动设置时区”均为开启状态。
          </p>
        </div>

        <!-- Issue 4 -->
        <div class="p-5 rounded-xl border border-slate-200 bg-white space-y-2">
          <div class="font-bold text-brand-dark text-sm">
            <span>🔴 故障四：国内主流杀毒防护软件误杀 Mihomo 内核或拦截 Wintun 驱动</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            <strong>核心原因：</strong>第三方杀毒防护软件的启发式扫描引擎会将具备网络层底层截获特性的 Wintun 驱动或经过加壳的代理内核误报为风险木马并静默隔离。<br />
            <strong>解决步骤：</strong>打开防护软件的安全日志或隔离区，将 Clash Verge Rev 及其核心可执行文件（mihomo-windows-amd64.exe）添加到信任白名单，并重新安装服务模式。
          </p>
        </div>
      </div>
    </section>

