---
import BaseLayout from '../../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '客户端', href: '/clients/' },
  { name: 'sing-box 专栏', href: '/clients/sing-box/' },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: 'sing-box 官方客户端与通用通用代理核心全景指南 2026最新版 极简架构与多平台通用网络栈深度实战',
  description: '全景解析通用网络代理平台 sing-box：纯 JSON 配置规范、跨全平台原生客户端支持、微内核极致轻量、VLESS Reality 与 ShadowTLS 协议生态深度应用。',
  datePublished: '2026-10-19',
  dateModified: '2026-11-24',
  inLanguage: 'zh-CN',
};

const faqs = [
  {
    q: 'sing-box 相比 Clash 生态最大的架构不同是什么？',
    a: 'sing-box 彻底摒弃了臃肿的 YAML 配置和历史包袱，采用高度结构化、严谨且无二义性的标准 JSON 格式作为唯一的官方配置标准。在内核设计上，sing-box 剥离了多余的图形与辅助依赖，专注成为纯粹的高性能网络平台，原生支持包括 iOS Network.framework、Android VpnService、Linux eBPF 在内的操作系统原生网络栈，在移动端具备更出色的低功耗与抗后台杀进程能力。'
  },
  {
    q: '为什么目前多数机场不直接提供原生 sing-box 订阅链接？',
    a: '由于 sing-box 采用纯 JSON 语法且规则字段与经典 Clash 差异巨大（例如出站标签使用 outbounds 数组，规则使用 route.rules 并在匹配逻辑上采用严格自顶向下的布尔判定），许多老旧机场的财务面板（如早期的 SSPanel 或 V2Board）尚未集成原生 sing-box 模板导出模块。用户通常需要借助本地自建的 Subconverter 容器或者第三方开源订阅转换工具，将 Clash 订阅转换为 sing-box 兼容的标准 JSON 格式。'
  },
  {
    q: '在 iOS 苹果手机上，sing-box 官方客户端能否替代收费的 Shadowrocket？',
    a: '在基础的节点分流、加密网络代理与流媒体解锁场景下完全可以替代，且 sing-box 在 App Store 很多国家和地区（包括部分外区非美区账户）均可免费下载使用。但需要注意：sing-box 官方客户端定位于严谨的极客工具，没有像小火箭那样内置一键测速大榜、正则节点批量重命名或直观的节点 Ping 延迟瀑布流卡片，适合追求极低电量消耗与极致轻量的进阶用户。'
  }
];
---

<BaseLayout
  title="sing-box 官方客户端与通用代理核心全景指南 (2026最新) - 机场 Wiki"
  description="全景解析通用网络代理平台 sing-box：纯 JSON 配置规范、跨全平台原生客户端支持、微内核极致轻量、VLESS Reality 与 ShadowTLS 协议生态深度应用。"
  breadcrumbs={breadcrumbs}
  schema={articleSchema}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <header class="pb-6 border-b border-brand-border space-y-3">
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 text-xs font-semibold rounded bg-purple-100 text-purple-800">
          通用网络平台
        </span>
        <span class="text-xs text-brand-muted font-mono">v1.10+ · 纯 JSON 严谨架构</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-extrabold text-brand-dark tracking-tight leading-tight">
        sing-box 官方客户端与通用代理核心全景指南
      </h1>
      <p class="text-sm sm:text-base text-brand-muted max-w-3xl leading-relaxed">
        由 nekohasekai 发起构建的通用代理网络平台，以极其严苛的类型约束、极小内存常驻与全平台一致的原生网络抽象，正在成为全球高级网络工程师的首选底层工具。
      </p>
    </header>

    <!-- Lead Answer Box -->
    <div class="p-5 rounded-xl border border-purple-200 bg-purple-50/70 space-y-2">
      <div class="flex items-center gap-2 text-xs font-bold text-purple-900 uppercase tracking-wide">
        <span class="w-2 h-2 rounded-full bg-purple-600"></span>
        核心定位与技术价值
      </div>
      <p class="text-xs sm:text-sm text-slate-800 leading-relaxed font-medium">
        sing-box 是一个真正的“跨平台网络瑞士军刀”。与传统的代理客户端不同，它既可以作为独立的移动端 App（iOS/Android）、桌面客户端（macOS/Windows），也可以作为路由器底层的 Linux 系统守护进程或嵌入式软路由网关运行，具备全行业最低的常驻内存开销。
      </p>
    </div>

    <!-- Section 1: Architecture Highlights -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        sing-box 的核心技术架构哲学
      </h2>
      <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
        与很多“功能堆砌型”软件不同，sing-box 的设计高度克制且崇尚模块化。在协议实现上，它拒绝包含任何不安全的已过时旧协议，严格支持现代化的 Trojan、VLESS、VMess、Hysteria 2、TUIC v5、Shadowsocks 以及 WireGuard；在规则流转上，通过 `inbounds`（入站）、`outbounds`（出站）与 `route`（路由规则）三者的清晰管线，杜绝了多重转发时的逻辑歧义。
      </p>
    </section>

    <!-- Section 2: Comparison Table -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        sing-box 与 Clash 架构关键差异对照
      </h2>
      <div class="overflow-x-auto border border-slate-200 rounded-xl bg-white shadow-2xs">
        <table class="w-full text-left text-xs sm:text-sm text-slate-600">
          <thead class="bg-slate-50 text-slate-700 font-semibold border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">技术特性</th>
              <th class="py-3 px-4 bg-purple-50 text-purple-900">sing-box 架构</th>
              <th class="py-3 px-4">Clash / Mihomo 架构</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <tr>
              <td class="py-2.5 px-4 font-medium text-brand-dark">配置文件语言</td>
              <td class="py-2.5 px-4 bg-purple-50/50 text-purple-900 font-semibold">Strict JSON (严谨无缩进错误)</td>
              <td class="py-2.5 px-4">YAML (极易因空格缩进报错)</td>
            </tr>
            <tr>
              <td class="py-2.5 px-4 font-medium text-brand-dark">移动端后台功耗</td>
              <td class="py-2.5 px-4 bg-purple-50/50 text-emerald-700 font-semibold">极低 (原生平台底层 API)</td>
              <td class="py-2.5 px-4">中等 (受常驻轮询影响)</td>
            </tr>
            <tr>
              <td class="py-2.5 px-4 font-medium text-brand-dark">分流规则编译</td>
              <td class="py-2.5 px-4 bg-purple-50/50 text-emerald-700 font-semibold">.srs 独立二进制规则集</td>
              <td class="py-2.5 px-4">GeoIP.dat / YAML Providers</td>
            </tr>
            <tr>
              <td class="py-2.5 px-4 font-medium text-brand-dark">新手学习曲线</td>
              <td class="py-2.5 px-4 bg-purple-50/50 text-amber-700 font-semibold">陡峭 (需理解出入站网络模型)</td>
              <td class="py-2.5 px-4 text-emerald-700 font-semibold">平缓 (国内 GUI 生态完善)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 3: Inbound & Outbound Pipeline -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        sing-box 的三段式配置逻辑拆解
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
          <span class="text-xs font-bold text-purple-600">模块 01: inbounds</span>
          <h3 class="font-bold text-sm text-brand-dark">多源流量接收入口</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            定义本机开放的监听端口，包括 mixed（HTTP/SOCKS5 混合代理端口）、tun（第三层网络虚拟网卡）以及 tproxy（透明网关）。
          </p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
          <span class="text-xs font-bold text-purple-600">模块 02: outbounds</span>
          <h3 class="font-bold text-sm text-brand-dark">出站节点与策略组</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            容纳从机场订阅导入的实体代理节点，以及 direct（直连）、block（广告拦截）、selector（手动选择）、urltest（自动测速优选）策略组。
          </p>
        </div>
        <div class="p-4 rounded-xl border border-slate-200 bg-white space-y-2">
          <span class="text-xs font-bold text-purple-600">模块 03: route</span>
          <h3 class="font-bold text-sm text-brand-dark">确定性自顶向下分流</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            规则匹配严格遵循先后顺序。当一个网络请求到来时，自顶向下匹配规则列表，一旦命中立即执行对应的出站动作，逻辑极其清晰透明。
          </p>
        </div>
      </div>
    </section>

    <!-- Section 4: FAQ -->
    <section class="space-y-4">
      <h2 class="text-xl font-bold text-brand-dark flex items-center gap-2">
        常见疑难解答与实操 FAQ
      </h2>
      <div class="space-y-3">
        {faqs.map((faq) => (
          <details class="group border border-slate-200 rounded-xl bg-white p-4 transition-colors hover:border-slate-300">
            <summary class="font-bold text-xs sm:text-sm text-brand-dark cursor-pointer flex items-center justify-between list-none">
              <span class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-600"></span>
                {faq.q}
              </span>
              <span class="text-slate-400 text-xs transition-transform group-open:rotate-180">▼</span>
            </summary>
            <p class="mt-3 text-xs sm:text-sm text-slate-600 leading-relaxed pl-3.5 border-t border-slate-100 pt-3">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </section>

    <!-- Navigation Back -->
    <div class="pt-6 border-t border-brand-border flex items-center justify-between text-xs">
      <a href="/clients/" class="text-brand-link hover:underline">
        ← 返回客户端大全
      </a>
      <a href="/guides/subscription-import-guide/" class="text-brand-link hover:underline">
        阅读订阅导入与格式转换完全教程 →
      </a>
    </div>
  </div>
</BaseLayout>
