---
import BaseLayout from '../layouts/BaseLayout.astro';

const breadcrumbs = [
  { name: '404 页面未找到', href: '/404/' },
];
---

<BaseLayout
  title="404 页面未找到 - 机场 Wiki"
  description="抱歉，您访问的页面不存在或已被迁移。"
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-16 text-center space-y-6">
    <div class="text-6xl font-extrabold text-blue-600 font-mono">404</div>
    <h1 class="text-2xl font-bold text-brand-dark">抱歉，您要访问的百科页面不存在</h1>
    <p class="text-xs sm:text-sm text-slate-600 max-w-md mx-auto leading-relaxed">
      该页面可能已被移动、合并或重命名。请通过下方按钮返回首页，或使用检索功能查找您需要的品牌与技术专题。
    </p>
    <div class="flex items-center justify-center gap-3 pt-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-lg bg-brand-dark hover:bg-brand-link text-white font-semibold text-xs transition-colors"
      >
        返回百科首页
      </a>
      <a
        href="/brands/"
        class="px-5 py-2.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium text-xs transition-colors"
      >
        查阅 31 家品牌库
      </a>
    </div>
  </div>
</BaseLayout>
