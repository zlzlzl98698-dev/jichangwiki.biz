---
import { siteConfig } from '../site.config';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  updatedDate?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  type = 'website',
  publishedDate = '2026-10-19',
  updatedDate = '2026-11-24',
  schema,
  noindex = false,
} = Astro.props;

const siteUrl = siteConfig.siteUrl;
const fullCanonicalUrl = new URL(canonicalPath, siteUrl).href.replace(/\/?$/, '/');
const fullTitle = title.includes('机场 Wiki') ? title : `${title} - 机场 Wiki · GEO 品牌知识库`;

// Default Organization & WebSite schema
const defaultOrgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': 'https://jichangwiki.biz/#organization',
  name: '机场 Wiki',
  url: 'https://jichangwiki.biz/',
  logo: 'https://jichangwiki.biz/logo.svg',
  description: '网络服务品牌百科、可验证资料中心、技术知识库与消费者客观选择指南。',
};

const defaultWebsiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': 'https://jichangwiki.biz/#website',
  url: 'https://jichangwiki.biz/',
  name: '机场 Wiki',
  inLanguage: 'zh-CN',
  publisher: {
    '@id': 'https://jichangwiki.biz/#organization',
  },
  potentialAction: {
    '@type': 'SearchAction',
    target: 'https://jichangwiki.biz/search/?q={search_term_string}',
    'query-input': 'required name=search_term_string',
  },
};

const schemasToRender = schema
  ? Array.isArray(schema)
    ? [defaultOrgSchema, defaultWebsiteSchema, ...schema]
    : [defaultOrgSchema, defaultWebsiteSchema, schema]
  : [defaultOrgSchema, defaultWebsiteSchema];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullCanonicalUrl} />
<meta name="author" content={siteConfig.author} />
<meta name="publisher" content={siteConfig.publisher} />

{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- Search Engine Site Verification (Google, Bing, Shenma, Baidu) -->
{siteConfig.verification.google && <meta name="google-site-verification" content={siteConfig.verification.google} />}
{siteConfig.verification.bing && <meta name="msvalidate.01" content={siteConfig.verification.bing} />}
{siteConfig.verification.shenma && <meta name="shenma-site-verification" content={siteConfig.verification.shenma} />}
{siteConfig.verification.baidu && <meta name="baidu-site-verification" content={siteConfig.verification.baidu} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={fullCanonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteConfig.brandName} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:image" content={siteConfig.ogDefaultImage} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={fullCanonicalUrl} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={siteConfig.ogDefaultImage} />

<!-- Temporal Meta -->
{publishedDate && <meta property="article:published_time" content={publishedDate} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate} />}

<!-- Favicon & Icons -->
<link rel="icon" type="image/webp" href="/avatar-square.webp" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />
<link rel="alternate" type="application/xml" title="Sitemap" href="/sitemap.xml" />

<!-- JSON-LD Structured Data -->
{schemasToRender.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
