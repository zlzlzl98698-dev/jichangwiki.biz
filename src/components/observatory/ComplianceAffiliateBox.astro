---
export interface Props {
  brandName: string;
  affiliateUrl: string;
  couponCode?: string | null;
  discountDesc?: string | null;
  isFeaturedPartner?: boolean;
}

const {
  brandName,
  affiliateUrl,
  couponCode,
  discountDesc,
  isFeaturedPartner = false,
} = Astro.props;
---

<div class="my-6 p-4 sm:p-5 rounded-xl border border-blue-200 bg-blue-50/40 text-brand-text">
  <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="font-semibold text-brand-dark text-base">{brandName} 注册与服务入口</span>
        {isFeaturedPartner && (
          <span class="px-2 py-0.5 text-[11px] font-medium rounded bg-amber-100 text-amber-800 border border-amber-200">
            合作品牌展示位
          </span>
        )}
      </div>

      <div class="text-xs text-brand-muted flex flex-wrap items-center gap-3">
        {couponCode && (
          <span>
            可用优惠码: <code class="px-1.5 py-0.5 rounded bg-white border border-blue-200 text-blue-700 font-mono font-bold">{couponCode}</code>
            {discountDesc && <span class="text-slate-500 ml-1">({discountDesc})</span>}
          </span>
        )}
        <span>支付方式: 支付宝 / 微信 / USDT</span>
      </div>
    </div>

    <!-- CTA Button -->
    <div class="w-full sm:w-auto flex flex-col items-center sm:items-end">
      <a
        href={affiliateUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg bg-brand-link hover:bg-blue-700 text-white font-medium text-sm shadow-xs transition-colors"
      >
        <span>访问 {brandName} 官网</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Compliance Note -->
  <div class="mt-3 pt-3 border-t border-blue-100/80 text-[11px] text-slate-500 flex items-center justify-between">
    <span>
      * 合规声明：含推广链接，通过链接注册可能为本站带来维护佣金，不影响用户实际支付价格。最终价格与套餐条款以服务商收银台页面为准。
    </span>
  </div>
</div>
