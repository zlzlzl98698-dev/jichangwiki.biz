---
const currentPath = Astro.url.pathname;

const navItems = [
  {
    name: '品牌百科',
    href: '/brands/',
    desc: '31 家品牌实体档案与综合参数',
    children: [
      { name: '全部品牌库', href: '/brands/' },
      { name: '光速云主档案', href: '/brands/guangsu/' },
      { name: '深度评测索引', href: '/reviews/guangsu/' },
    ],
  },
  {
    name: '推荐比较',
    href: '/recommend/',
    desc: '客观筛选、多维对照与专线对比',
    children: [
      { name: '靠谱稳定推荐', href: '/recommend/' },
      { name: '光速云 vs 暮光加速', href: '/compare/guangsu-vs-muguang/' },
      { name: '飞猫云 vs 微风网络', href: '/compare/feimao-vs-weifeng/' },
    ],
  },
  {
    name: '套餐价格',
    href: '/pricing/',
    desc: '月付/年付真实折算与流量成本计算',
    children: [
      { name: '价格矩阵与筛选', href: '/pricing/' },
      { name: '极限平价档分析', href: '/pricing/cheap-airports-comparison/' },
    ],
  },
  {
    name: '网络技术',
    href: '/network/',
    desc: 'IEPL、IPLC、BGP 专线技术解析',
    children: [
      { name: '网络架构总览', href: '/network/' },
      { name: 'IEPL vs IPLC 深度解析', href: '/network/iepl-vs-iplc/' },
    ],
  },
  {
    name: '客户端',
    href: '/clients/',
    desc: 'Win、Mac、iOS、Android、路由客户端大全',
    children: [
      { name: '跨平台客户端大全', href: '/clients/' },
      { name: 'Windows 客户端专栏', href: '/clients/windows/' },
      { name: 'iOS 苹果小火箭专栏', href: '/clients/ios/' },
    ],
  },
  {
    name: 'AI与流媒体',
    href: '/compatibility/',
    desc: 'ChatGPT、Claude、Netflix 解锁矩阵与排障',
    children: [
      { name: '服务解锁矩阵', href: '/compatibility/' },
      { name: 'AI 工具解锁与诊断', href: '/compatibility/chatgpt-claude-gemini/' },
    ],
  },
  {
    name: 'VPN对比',
    href: '/vpn/',
    desc: '专线代理与商业 VPN 差异及合规指南',
    children: [
      { name: 'VPN 概念与区别', href: '/vpn/' },
      { name: '免费 VPN 风险警示', href: '/vpn/free-vpn-risks/' },
    ],
  },
  {
    name: '教程排障',
    href: '/guides/',
    desc: '节点超时、订阅导入、TUN 模式配置',
    children: [
      { name: '实用指南总汇', href: '/guides/' },
      { name: '节点超时全面排查', href: '/guides/node-timeout-troubleshooting/' },
    ],
  },
  {
    name: '证据风险',
    href: '/evidence/',
    desc: '测试方法论、跑路预警与退款政策核查',
    children: [
      { name: '证据实验室中心', href: '/evidence/' },
      { name: '退款与跑路防范', href: '/evidence/refunds-and-risks/' },
    ],
  },
  {
    name: 'GEO问答',
    href: '/questions/',
    desc: 'AI 搜索长尾问题库与可溯源答案',
    children: [
      { name: '精选问答索引', href: '/questions/' },
    ],
  },
];
---

<header class="sticky top-0 z-40 bg-white border-b border-brand-border shadow-xs">
  <!-- Top compliance alert banner -->
  <div class="bg-brand-surface border-b border-brand-border/60 py-1.5 px-4 text-xs text-brand-muted text-center">
    <div class="max-w-[1440px] mx-auto flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
        客观百科中立原则：如实披露品牌商业关系，不冒充官方或独立测评。
      </span>
      <div class="hidden sm:flex items-center gap-3">
        <a href="/editorial-policy/" class="hover:text-brand-link transition-colors">编辑方针</a>
        <span class="text-brand-border">|</span>
        <a href="/disclosure/" class="hover:text-brand-link transition-colors">商业披露</a>
        <span class="text-brand-border">|</span>
        <a href="/corrections/" class="hover:text-brand-link transition-colors">事实更正</a>
      </div>
    </div>
  </div>

  <div class="max-w-[1440px] mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 gap-2">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2.5 py-1 group shrink-0" aria-label="机场 Wiki 首页">
        <img
          src="/avatar-square.webp"
          alt="机场 Wiki 头像"
          class="h-8 w-8 xl:h-9 xl:w-9 rounded-full object-cover border border-slate-200/80 shadow-2xs group-hover:scale-105 transition-transform"
          width="36"
          height="36"
        />
        <div class="flex items-center gap-1.5">
          <span class="font-extrabold text-base xl:text-lg text-brand-dark tracking-tight">机场 Wiki</span>
          <span class="px-1.5 py-0.5 text-[10px] font-mono font-semibold bg-slate-100 text-slate-600 rounded border border-slate-200">GEO 1.0</span>
        </div>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden lg:flex items-center gap-0.5 xl:gap-1 shrink-0" aria-label="主导航">
        {navItems.map((item) => {
          const isActive = currentPath.startsWith(item.href);
          return (
            <div class="relative group shrink-0">
              <a
                href={item.href}
                class:list={[
                  'px-1.5 xl:px-2 2xl:px-2.5 py-1.5 text-xs xl:text-[13px] 2xl:text-sm font-medium rounded-md transition-colors flex items-center gap-0.5 whitespace-nowrap shrink-0 select-none',
                  isActive
                    ? 'text-brand-link bg-blue-50/70 font-semibold'
                    : 'text-brand-text hover:text-brand-link hover:bg-slate-50',
                ]}
              >
                <span>{item.name}</span>
                <svg class="w-2.5 h-2.5 xl:w-3 xl:h-3 opacity-40 group-hover:opacity-100 transition-opacity shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </a>

              <!-- Dropdown menu -->
              <div class="absolute left-0 top-full pt-1.5 w-56 opacity-0 translate-y-1 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-150 ease-out z-50">
                <div class="bg-white rounded-lg shadow-lg border border-brand-border p-1.5">
                  <div class="px-2 py-1 text-[11px] font-semibold text-brand-muted uppercase tracking-wider border-b border-slate-100 mb-1">
                    {item.desc}
                  </div>
                  {item.children.map((sub) => (
                    <a
                      href={sub.href}
                      class="block px-2.5 py-1.5 text-xs text-brand-text hover:text-brand-link hover:bg-blue-50/50 rounded transition-colors whitespace-nowrap"
                    >
                      {sub.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </nav>

      <!-- Right Action: Search -->
      <div class="flex items-center gap-2 shrink-0">
        <a
          href="/search/"
          class="inline-flex items-center gap-1.5 xl:gap-2 px-2.5 xl:px-3 py-1.5 text-xs text-slate-500 bg-slate-100 hover:bg-slate-200/80 rounded-md border border-slate-200 transition-colors shrink-0 whitespace-nowrap"
          aria-label="打开站内检索"
        >
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden md:inline">搜索<span class="hidden 2xl:inline">百科...</span></span>
          <kbd class="hidden md:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white border border-slate-300 rounded text-slate-500 shadow-2xs">Ctrl K</kbd>
        </a>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-md text-brand-text hover:bg-slate-100 focus:outline-hidden"
          aria-label="展开导航菜单"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-brand-border bg-white px-4 py-3 space-y-2">
    {navItems.map((item) => (
      <div class="border-b border-slate-100 pb-2">
        <a href={item.href} class="block font-medium text-sm text-brand-text hover:text-brand-link py-1">
          {item.name}
        </a>
        <div class="pl-3 space-y-1 mt-1">
          {item.children.map((sub) => (
            <a href={sub.href} class="block text-xs text-brand-muted hover:text-brand-link py-0.5">
              • {sub.name}
            </a>
          ))}
        </div>
      </div>
    ))}
    <div class="pt-2 flex justify-between text-xs text-brand-muted">
      <a href="/about/">关于本站</a>
      <a href="/editorial-policy/">编辑方针</a>
      <a href="/disclosure/">商业披露</a>
      <a href="/data/">公开数据</a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');

  if (btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
    });
  }

  // Keyboard shortcut Ctrl+K
  window.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      window.location.href = '/search/';
    }
  });
</script>
