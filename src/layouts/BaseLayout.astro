---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEOHead from '../components/SEOHead.astro';
import Breadcrumbs, { type BreadcrumbItem } from '../components/Breadcrumbs.astro';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  type?: 'website' | 'article';
  breadcrumbs?: BreadcrumbItem[];
  publishedDate?: string;
  updatedDate?: string;
  schema?: Record<string, any> | Array<Record<string, any>>;
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  breadcrumbs,
  publishedDate,
  updatedDate,
  schema,
  noindex = false,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      type={type}
      publishedDate={publishedDate}
      updatedDate={updatedDate}
      schema={schema}
      noindex={noindex}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-brand-text">
    <!-- Skip to content for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:px-4 focus:py-2 focus:bg-brand-dark focus:text-white focus:rounded"
    >
      跳转到主要内容
    </a>

    <Header />

    <main id="main-content" class="flex-1 w-full">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-slate-100 bg-slate-50/50">
          <Breadcrumbs items={breadcrumbs} />
        </div>
      )}
      <slot />
    </main>

    <Footer />
  </body>
</html>
