# 机场 Wiki · GEO Brand Knowledge Engine 1.0 环境变量说明

# 公开站点基础配置
PUBLIC_SITE_URL=https://jichangwiki.biz
PUBLIC_BUILD_ENV=production

# 搜索引擎站长平台所有权验证（可选，获得对应平台验证码后填入并重新构建即可自动生效）
PUBLIC_GOOGLE_SITE_VERIFICATION=
PUBLIC_BING_SITE_VERIFICATION=
PUBLIC_SHENMA_SITE_VERIFICATION=
PUBLIC_BAIDU_SITE_VERIFICATION=

# Cloudflare D1 数据库配置（本地与生产）
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_D1_DATABASE_ID=your_d1_database_id
CF_D1_TOKEN=your_cloudflare_api_token

# Cloudflare Access 保护（知识库管理端）
CF_ACCESS_TEAM_NAME=your_team_name
CF_ACCESS_AUD=your_access_application_aud
CF_ACCESS_JWKS_URL=https://<your_team_name>.cloudflareaccess.com/cdn-cgi/access/certs

# 安全与发布 Webhook
BUILD_HOOK_SECRET=your_secret_build_hook_token
ADMIN_SESSION_SECRET=your_admin_jwt_session_secret
